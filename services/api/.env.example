# Kumogakure API ローカル開発用環境変数テンプレート
# 使い方: cp .env.example .env して値を設定（.env は Git 管理外）

PORT=8080
APP_ENV=local
BASE_URL=http://localhost:8080
FONTS_DIR=assets/fonts

# Turso / ローカル SQLite 接続先（ローカル検証時は file:./local.db または :memory:）
TURSO_DATABASE_URL=file:./local.db
# TURSO_AUTH_TOKEN=

# Week 2 以降で使用するシークレット・外部連携（ローカル起動のみなら未設定でも起動可）
# REVENUECAT_SECRET_API_KEY=sk_example
# REVENUECAT_BASE_URL=https://api.revenuecat.com
REVENUECAT_FAIL_OPEN=true
# INTERNAL_CLEANUP_SECRET=replace-with-64-char-random-secret
REPORT_FORM_URL_TEMPLATE=https://docs.google.com/forms/d/e/1FAIpQLSf4jPMH3ZLLRR6u6AB4S8t5xHg3zGQDsmFG_mIDqrxwxEX2Wg/viewform?usp=pp_url&entry.1371370885={session_id}
# SUPPORT_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScOjICc8nN83rTRGXd2oYbvBicAxNB8yvrFXsNFjE00xLIqgQ/viewform
# APP_STORE_URL=https://apps.apple.com/?utm_source=absence_card&utm_medium=web
# OGP_MAX_CONCURRENCY=4
# NG_WORDS_EXTRA=

RUST_LOG=info,kumogakure_api=debug
